# Copy this file to .claude/db-sync.local.env and fill in your own values.
#
# .claude/db-sync.local.env never gets committed: the project's root
# .gitignore already ignores everything under .claude/ except .claude/skills/,
# and scripts/db-sync.sh double-checks that with `git check-ignore` before it
# runs anyway, in case that rule ever changes. Still, treat this file the way
# you'd treat a password: don't paste its contents into chat, issues, or PRs.

# Remote server (production/staging) — whatever the client SSH access uses.
SSH_HOST=
SSH_PORT=22
SSH_USER=

# Path to the Drupal app root on the server — the directory containing
# composer.json / vendor/bin/drush for the site you're syncing from.
REMOTE_APP_PATH=

# Optional. Only needed if the server's default `php` on PATH is older than
# this project's Drupal requires and drush refuses to run. Point this at a
# newer binary (shared hosts often keep alternates like
# /opt/alt/phpNN/usr/bin/php, cPanel-style paths, or similar — check what's
# on your server rather than guessing).
REMOTE_PHP_BIN=

# Optional. Local DDEV project name, if it's not the one DDEV auto-detects
# from the current directory.
LOCAL_DDEV_PROJECT=
