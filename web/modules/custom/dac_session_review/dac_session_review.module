<?php

/**
 * @file
 * Blind review for session proposals.
 *
 * Session moderators rate proposals on their content, not on who submitted
 * them. Most of that is permissions (no "view field_speakers", no session
 * revisions, no content overview); this covers the one place a permission
 * can't: the node form's "Author" line in the edit sidebar, which core
 * shows to anyone who can edit the node.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 */
function dac_session_review_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'session' || !isset($form['meta']['author'])) {
    return;
  }
  $form['meta']['author']['#access'] = \Drupal::currentUser()->hasPermission('administer nodes');
}

/**
 * Implements hook_theme().
 */
function dac_session_review_theme(): array {
  return [
    'session_review_results' => [
      'variables' => [
        'rows' => [],
        'headers' => [],
        'tracks' => [],
        'track' => '',
        'track_label' => NULL,
        'sort' => 'score',
        'order' => 'desc',
        'max' => 10,
        'form_action' => '',
        'show_filter' => TRUE,
        'all_label' => NULL,
        'own_tracks' => FALSE,
        'no_track' => FALSE,
      ],
    ],
  ];
}

/**
 * The session categories a user's Session Ratings list is limited to.
 *
 * Moderators are assigned one or two tracks (session categories) in their
 * account's admin-only "Session category" field and only see those tracks'
 * sessions.
 *
 * @return int[]|null
 *   NULL if the user sees every track; the category term IDs otherwise, or
 *   an empty array if they are limited but have no category assigned yet.
 */
function _dac_session_review_tracks(AccountInterface $account): ?array {
  if ($account->hasPermission('rate sessions in all tracks')) {
    return NULL;
  }
  $user = \Drupal::entityTypeManager()->getStorage('user')->load($account->id());
  if (!$user || !$user->hasField('field_moderator_category')) {
    return [];
  }
  return array_values(array_filter(array_map('intval', array_column($user->get('field_moderator_category')->getValue(), 'target_id'))));
}

/**
 * Implements hook_form_FORM_ID_alter() for user_form.
 *
 * Session moderators must have at least one track. Making the field
 * required would force organisers to pick one for every account, speakers
 * included, so it is only enforced for the Session moderator role. The
 * maximum of two is the field's cardinality.
 */
function dac_session_review_form_user_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (isset($form['field_moderator_category'])) {
    $form['#validate'][] = '_dac_session_review_moderator_category_validate';
  }
}

/**
 * Form validation: a session moderator needs at least one track.
 */
function _dac_session_review_moderator_category_validate(array &$form, FormStateInterface $form_state): void {
  if (($form['field_moderator_category']['#access'] ?? TRUE) === FALSE) {
    return;
  }
  // The roles element is only on the form for users who may assign roles;
  // otherwise the account keeps the roles it has.
  $roles = $form_state->hasValue('roles')
    ? array_values(array_filter((array) $form_state->getValue('roles')))
    : $form_state->getFormObject()->getEntity()->getRoles();
  if (!in_array('session_moderator', $roles, TRUE)) {
    return;
  }
  $tracks = array_filter(array_column((array) $form_state->getValue('field_moderator_category'), 'target_id'));
  if (!$tracks) {
    $form_state->setErrorByName('field_moderator_category', t('Session moderators need at least one session category.'));
  }
}

/**
 * Whether a session is the user's own, so they must not evaluate it.
 *
 * A session is someone's own if they are one of its speakers or submitted
 * it. Submitting only counts for non-admins: organisers enter sessions on
 * speakers' behalf and still need to rate those.
 */
function _dac_session_review_is_own_session(AccountInterface $account, int $nid): bool {
  if (!$nid || $account->isAnonymous()) {
    return FALSE;
  }
  $node = \Drupal::entityTypeManager()->getStorage('node')->load($nid);
  if (!$node || $node->bundle() !== 'session') {
    return FALSE;
  }
  $uid = (int) $account->id();
  if ($node->hasField('field_speakers') && in_array($uid, array_map('intval', array_column($node->get('field_speakers')->getValue(), 'target_id')), TRUE)) {
    return TRUE;
  }
  return (int) $node->getOwnerId() === $uid && !$account->hasPermission('administer nodes');
}

/**
 * Implements hook_views_pre_view().
 *
 * On the Session Ratings page, tells a limited user which tracks they are
 * rating, or that they have none yet.
 */
function dac_session_review_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== 'session_ratings' || $display_id !== 'page_1') {
    return;
  }
  $view->element['#cache']['contexts'][] = 'user';
  $tracks = _dac_session_review_tracks(\Drupal::currentUser());
  if ($tracks === NULL) {
    return;
  }

  $labels = array_map(fn($term) => $term->label(), $tracks ? \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadMultiple($tracks) : []);
  $message = match (count($labels)) {
    0 => t('No track has been assigned to you yet, so there are no sessions to rate. Ask an organiser to set your session category.'),
    1 => t('Showing sessions in your track: <strong>@track</strong>.', ['@track' => reset($labels)]),
    default => t('Showing sessions in your tracks: <strong>@tracks</strong>.', ['@tracks' => implode(', ', $labels)]),
  };
  $view->addHandler($display_id, 'header', 'views', 'area_text_custom', [
    'content' => '<p class="dac-track-note">' . $message . '</p>',
    'empty' => TRUE,
  ], 'dac_track');
}

/**
 * Implements hook_views_data_alter().
 */
function dac_session_review_views_data_alter(array &$data): void {
  $data['node_field_data']['dac_user_seeded_random'] = [
    'title' => t('Random (fixed per user)'),
    'help' => t('Shuffles content differently for each user, but keeps that order across pages and visits, so paging neither repeats nor skips items.'),
    'sort' => [
      'id' => 'dac_user_seeded_random',
      'field' => 'nid',
    ],
  ];

  // Sessions saved before "Invited session" existed have no row for it, so
  // an "Invited session = No" filter has to treat NULL as No, or Session
  // Ratings and Session Moderation would drop every older session.
  if (isset($data['node__field_is_invited']['field_is_invited_value']['filter'])) {
    $data['node__field_is_invited']['field_is_invited_value']['filter']['accept null'] = TRUE;
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Limits every display of the Session Ratings view (the "to rate" list and
 * the attached "Already rated by you" list) to the user's tracks. Done in
 * the query rather than through the exposed Category filter, so it holds
 * whatever is passed in the URL.
 */
function dac_session_review_views_query_alter(ViewExecutable $view, QueryPluginBase $query): void {
  if ($view->id() !== 'session_ratings') {
    return;
  }

  // "To rate" list: it drops sessions you rated with a "submitter is not
  // you" argument over a join to every evaluation of the session, so each
  // other moderator's evaluation let a session you had rated back in, and
  // listed it once per evaluator. Joining only your own evaluations leaves
  // at most one row per session, which the argument then keeps or drops.
  if ($view->current_display === 'page_1' && ($join = $query->getTableInfo('webform_submission_data')['join'] ?? NULL)) {
    $own = \Drupal::database()->select('webform_submission', 's')
      ->fields('s', ['sid'])
      ->condition('s.webform_id', 'session_evaluation')
      ->condition('s.uid', \Drupal::currentUser()->id())
      ->execute()
      ->fetchCol();
    // Views' join builder only brackets an IN list of two or more values.
    $own = $own ?: [0];
    $join->extra[] = count($own) > 1
      ? ['field' => 'sid', 'value' => $own, 'operator' => 'IN']
      : ['field' => 'sid', 'value' => reset($own)];
  }

  // Nobody is offered their own sessions to rate.
  $account = \Drupal::currentUser();
  $mine = \Drupal::database()->select('node__field_speakers', 'sp')
    ->fields('sp', ['entity_id'])
    ->condition('sp.field_speakers_target_id', $account->id())
    ->condition('sp.deleted', 0)
    ->execute()
    ->fetchCol();
  if (!$account->hasPermission('administer nodes')) {
    $mine = array_merge($mine, \Drupal::entityQuery('node')
      ->accessCheck(FALSE)
      ->condition('type', 'session')
      ->condition('uid', $account->id())
      ->execute());
  }
  if ($mine) {
    $query->addWhere(0, 'node_field_data.nid', array_values(array_unique($mine)), 'NOT IN');
  }

  $tracks = _dac_session_review_tracks(\Drupal::currentUser());
  if ($tracks === NULL) {
    return;
  }
  if (!$tracks) {
    $query->addWhereExpression(0, '1 = 0');
    return;
  }
  $in_track = \Drupal::database()->select('node__field_session_category', 'c')
    ->fields('c', ['entity_id'])
    ->condition('c.field_session_category_target_id', $tracks, 'IN')
    ->condition('c.deleted', 0);
  $query->addWhere(0, 'node_field_data.nid', $in_track, 'IN');
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * Hides the Category filter (the only exposed filter) from users limited
 * to their own tracks; it lists every track, most of which could only
 * narrow their list to nothing.
 */
function dac_session_review_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $view = $form_state->get('view');
  if ($view && $view->id() === 'session_ratings' && _dac_session_review_tracks(\Drupal::currentUser()) !== NULL) {
    $form['#access'] = FALSE;
  }
}

/**
 * Implements hook_webform_submission_form_alter().
 *
 * The evaluation form opens from a session page with its session already
 * filled in; track moderators cannot change which session they are rating.
 */
function dac_session_review_webform_submission_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form['#webform_id'] !== 'session_evaluation' || !isset($form['elements']['session'])) {
    return;
  }
  $form['#cache']['contexts'][] = 'user.permissions';
  $form['#cache']['contexts'][] = 'user';
  $form['#cache']['contexts'][] = 'url.query_args:session';

  // Never let anyone evaluate their own session, whether they arrive with it
  // prefilled (?session=) or pick it in the field.
  $session = $form['elements']['session']['#default_value'] ?? NULL;
  $session = is_array($session) ? reset($session) : $session;
  $nid = (int) (is_object($session) ? $session->id() : $session);
  if (_dac_session_review_is_own_session(\Drupal::currentUser(), $nid)) {
    $form = [
      '#cache' => $form['#cache'],
      'message' => [
        '#markup' => '<p>' . t('You cannot evaluate a session you submitted or are speaking in.') . '</p>',
      ],
    ];
    return;
  }
  $form['#validate'][] = '_dac_session_review_not_own_session_validate';

  if (!\Drupal::currentUser()->hasPermission('rate sessions in all tracks') && !empty($form['elements']['session']['#default_value'])) {
    $form['elements']['session']['#disabled'] = TRUE;
  }
}

/**
 * Form validation: rejects an evaluation of the submitter's own session.
 */
function _dac_session_review_not_own_session_validate(array &$form, FormStateInterface $form_state): void {
  if (_dac_session_review_is_own_session(\Drupal::currentUser(), (int) $form_state->getValue('session'))) {
    $form_state->setErrorByName('session', t('You cannot evaluate a session you submitted or are speaking in.'));
  }
}
