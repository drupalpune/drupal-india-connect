{#
/**
 * @file
 * User account, full view mode: the public profile at /user/N.
 *
 * Overrides event_horizon's user--full, which reads fields this site
 * doesn't have. Same layout and CSS as the Featured Speaker page
 * (node--featured-speaker--full.html.twig): photo beside the name (h1),
 * designation and profile links; then the bio and the person's sessions
 * as cards. profile, speaker_links, speaker_slack, speaker_bio and
 * speaker_sessions come from drupal_india_connect_preprocess_user().
 */
#}
{{ attach_library('drupal_india_connect/speaker-detail') }}
{{ attach_library('core/components.drupal_india_connect--eyebrow') }}
<article{{ attributes.addClass('speaker-detail', 'user-profile') }}>
  <header class="speaker-detail__header">
    {% if profile.photo %}
      <div class="speaker-detail__photo">
        <img src="{{ profile.photo.src }}" alt="{{ profile.photo.alt }}" width="400" height="400" loading="lazy">
      </div>
    {% endif %}

    <div class="speaker-detail__intro">
      {% if profile.is_speaker %}
        <p class="eh-eyebrow eh-eyebrow--accent">{{ 'Speaker'|t }}</p>
      {% endif %}

      <h1 class="speaker-detail__name">{{ profile.name }}</h1>

      {% if profile.designation %}
        <p class="speaker-detail__designation">{{ profile.designation }}</p>
      {% endif %}

      {% include '@drupal_india_connect/includes/speaker-links.html.twig' with { links: speaker_links } only %}

      {% if speaker_slack %}
        <p class="speaker-detail__designation">{{ 'Drupal Slack: @@username'|t({'@username': speaker_slack}) }}</p>
      {% endif %}
    </div>
  </header>

  {% set bio = speaker_bio|render %}
  {% if bio|striptags|trim is not empty %}
    <div class="speaker-detail__bio">{{ bio }}</div>
  {% endif %}

  {% set sessions = speaker_sessions|render %}
  {% if sessions|striptags|trim is not empty %}
    <section class="speaker-detail__sessions" aria-labelledby="speaker-sessions-heading">
      <h2 id="speaker-sessions-heading" class="speaker-detail__sessions-heading">{{ 'Sessions'|t }}</h2>
      {{ sessions }}
    </section>
  {% endif %}
</article>
