{#
/**
 * @file
 * Featured Speaker, full view mode: the public speaker profile at
 * /speakers/<name>.
 *
 * Laid out like the session page (node--session--full.html.twig): photo
 * beside the name (h1), designation and profile links, stacked on phones;
 * then the bio, the talk (title, day/time/room, abstract, link to the
 * program) and the speaker's sessions as cards. speaker_links, speaker_bio,
 * speaker_talk and speaker_sessions come from
 * _drupal_india_connect_featured_speaker(). The badge ("Featured Speaker",
 * "Keynote") is shown as the eyebrow above the name.
 */
#}
{{ attach_library('drupal_india_connect/speaker-detail') }}
{{ attach_library('core/components.drupal_india_connect--eyebrow') }}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    not node.isPublished() ? 'node--unpublished',
    'node--view-mode-full',
    'speaker-detail',
  ]
%}
<article{{ attributes.addClass(classes) }}>
  <header class="speaker-detail__header">
    {% set photo = content.field_featured_image|render %}
    {% if photo|striptags('<img>')|trim is not empty %}
      <div class="speaker-detail__photo">{{ photo }}</div>
    {% endif %}

    <div class="speaker-detail__intro">
      {% if node.field_badge.value %}
        <p class="eh-eyebrow eh-eyebrow--accent">{{ node.field_badge.value }}</p>
      {% endif %}

      {{ title_prefix }}
      <h1{{ title_attributes.addClass('speaker-detail__name') }}>{{ label }}</h1>
      {{ title_suffix }}

      {% if node.field_designation.value %}
        <p class="speaker-detail__designation">{{ node.field_designation.value }}</p>
      {% endif %}

      {% include '@drupal_india_connect/includes/speaker-links.html.twig' with { links: speaker_links } only %}
    </div>
  </header>

  {% set bio = content.body|render ?: speaker_bio|render %}
  {% if bio|striptags|trim is not empty %}
    <div class="speaker-detail__bio">{{ bio }}</div>
  {% endif %}

  {#
    The talk (field_talk_title / field_talk_abstract): headed "Keynote" for
    a keynote badge. Day, time and room come from the Program page card that
    links to this page; until there is one they show as TBC.
  #}
  {% if speaker_talk %}
    {% set slot = speaker_talk.slot %}
    <section class="speaker-detail__talk" aria-labelledby="speaker-talk-heading">
      <h2 id="speaker-talk-heading" class="speaker-detail__sessions-heading">{{ speaker_talk.is_keynote ? 'Keynote'|t : 'Talk'|t }}</h2>
      <div class="speaker-detail__talk-card">
        <h3 class="speaker-detail__talk-title">{{ speaker_talk.title }}</h3>

        <ul class="speaker-detail__talk-meta">
          <li>
            {% include 'drupal_india_connect:icon' ignore missing with { icon: 'calendar', icon_size: 'extra-small' } only %}
            {%- if slot.day -%}
              <span class="visually-hidden">{{ 'Day:'|t }} </span>{{ slot.day }}
            {%- else -%}
              {{ 'Day'|t }} {% include 'drupal_india_connect:tbc-tag' ignore missing only %}
            {%- endif -%}
          </li>
          <li>
            {% include 'drupal_india_connect:icon' ignore missing with { icon: 'clock', icon_size: 'extra-small' } only %}
            {%- if slot.start and slot.end -%}
              <span class="visually-hidden">{{ 'Time:'|t }} </span><time{% if slot.date %} datetime="{{ slot.date }}T{{ slot.start }}"{% endif %}>{{ slot.start }}</time>&nbsp;–&nbsp;<time{% if slot.date %} datetime="{{ slot.date }}T{{ slot.end }}"{% endif %}>{{ slot.end }}</time>
            {%- else -%}
              {{ 'Time'|t }} {% include 'drupal_india_connect:tbc-tag' ignore missing only %}
            {%- endif -%}
          </li>
          <li>
            {% include 'drupal_india_connect:icon' ignore missing with { icon: 'map-pin', icon_size: 'extra-small' } only %}
            {%- if slot.room -%}
              <span class="visually-hidden">{{ 'Room:'|t }} </span>{{ slot.room }}
            {%- else -%}
              {{ 'Room'|t }} {% include 'drupal_india_connect:tbc-tag' ignore missing only %}
            {%- endif -%}
          </li>
        </ul>

        {% set abstract = content.field_talk_abstract|render %}
        {% if abstract|striptags|trim is not empty %}
          <div class="speaker-detail__talk-abstract">{{ abstract }}</div>
        {% endif %}

        {% if speaker_talk.program_url %}
          <a class="speaker-detail__talk-link dac-arrow-link" href="{{ speaker_talk.program_url }}">
            {{- 'See the full program'|t -}}
            {% include 'drupal_india_connect:icon' ignore missing with { icon: 'arrow-right', icon_size: 'extra-small' } only %}
          </a>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% set sessions = speaker_sessions|render %}
  {% if sessions|striptags|trim is not empty %}
    <section class="speaker-detail__sessions" aria-labelledby="speaker-sessions-heading">
      <h2 id="speaker-sessions-heading" class="speaker-detail__sessions-heading">{{ 'Sessions'|t }}</h2>
      {{ sessions }}
    </section>
  {% endif %}
</article>
