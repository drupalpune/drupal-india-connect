{#
/**
 * @file
 * Session node, full/canonical view mode only (the `--full` suffix keeps
 * teasers on session listing views untouched).
 *
 * Presents the session title as a real page heading, and moves metadata
 * (speakers, time, track, room, level, type, tags) into a labelled
 * <aside> beside the description, per the design reference at
 * https://events.drupal.org/rotterdam2026/session/ — the fields that only
 * matter during CFP review (code of conduct, speaking experience, session
 * consent) stay hidden in core.entity_view_display.node.session.default,
 * so the data is still on the entity, just not rendered here.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    'node--view-mode-full',
  ]
%}
<article{{ attributes.addClass(classes) }}>
  {% if content.content_moderation_control %}
    {{ content.content_moderation_control }}
  {% endif %}

  {{ title_prefix }}
  {% if page %}
    <h1{{ title_attributes.addClass('session-detail__title') }}>{{ label }}</h1>
  {% else %}
    <h2{{ title_attributes.addClass('session-detail__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('session-detail__layout') }}>
    <div class="session-detail__main">
      {% if content.field_synopsis %}
        <div class="session-detail__synopsis">{{ content.field_synopsis }}</div>
      {% endif %}

      {% if content.field_description %}
        {{ content.field_description }}
      {% endif %}
    </div>

    <div class="session-detail__sidebar">
      {% if session_evaluation %}
        <div class="session-detail__evaluation">{{ session_evaluation }}</div>
      {% endif %}

      {% set other_evaluations = session_other_evaluations|render %}
      {% if other_evaluations|trim is not empty %}
        <div class="session-detail__evaluation">{{ other_evaluations }}</div>
      {% endif %}

      <aside class="session-metadata" aria-labelledby="session-meta-heading">
        <h2 id="session-meta-heading" class="session-metadata__heading">Session details</h2>

        {#
          Empty fields still produce a non-empty render array (cache
          metadata), so `{% if content.field_x %}` printed blank rows.
          Render each one first and only print it when it has content.
        #}
        {% set schedule_action = content.flag_my_schedule|render %}
        {% if schedule_action|striptags|trim is not empty %}
          <div class="session-metadata__action">{{ schedule_action }}</div>
        {% endif %}

        {% set details = [
          { label: 'Speakers'|t, value: content.field_speakers|render, modifier: 'speakers' },
          { label: 'Time slot'|t, value: content.field_time_slot|render, modifier: 'time' },
          { label: 'Room'|t, value: content.field_r|render, modifier: 'room' },
          { label: 'Category'|t, value: content.field_session_category|render, modifier: 'category' },
          { label: 'Level'|t, value: content.field_audience|render, modifier: 'level' },
          { label: 'Type'|t, value: content.field_type|render, modifier: 'type' },
          { label: 'Tags'|t, value: content.field_session_tags|render, modifier: 'tags' },
        ] %}

        <dl class="session-metadata__list">
          {% for detail in details %}
            {% if detail.value|striptags|trim is not empty %}
              <div class="session-metadata__item session-metadata__item--{{ detail.modifier }}">
                <dt class="session-metadata__label">{{ detail.label }}</dt>
                <dd class="session-metadata__value">{{ detail.value }}</dd>
              </div>
            {% endif %}
          {% endfor %}
        </dl>
      </aside>
    </div>
  </div>

  {% if content.flippy_pager %}
    <div class="session-detail__pager">
      {{ content.flippy_pager }}
    </div>
  {% endif %}
</article>
