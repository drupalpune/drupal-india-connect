{#
/**
 * @file
 * Article in the "card" view mode, as listed on /blogs (views.view.blog).
 *
 * The excerpt comes from the body's summary if one was entered, otherwise
 * from the start of the body. Body is hidden in the card display itself,
 * so it is read from the entity here and stripped of markup — pasted
 * Google Docs content carries inline styles that must not leak into cards.
 */
#}
{{ attach_library('drupal_india_connect/blog') }}
{% set body = node.body.0 %}
{% set excerpt = (body.summary ?: body.value)|default('')|striptags|replace({'&nbsp;': ' '})|trim %}
{% if excerpt|length > 180 %}
  {% set excerpt = excerpt|slice(0, 180)|split(' ')|slice(0, -1)|join(' ') ~ '…' %}
{% endif %}

{#
  The image is rendered uncropped (media "medium" view mode) into a fixed
  16:9 frame. Photos near that shape fill it; anything much wider or taller
  — event banners, logos, portraits — is shown whole on a tint instead, so
  text and marks in the artwork are never cut off.
#}
{% set image = node.field_featured_image.entity.field_media_image.0 %}
{% set ratio = image and image.height ? image.width / image.height : 16 / 9 %}
{% set media_fit = ratio >= 1.3 and ratio <= 2.1 ? 'cover' : 'contain' %}

<article{{ attributes.addClass('dac-post-card') }}>
  {% if content.field_featured_image|render|trim is not empty %}
    <div class="dac-post-card__media dac-post-card__media--{{ media_fit }}">{{ content.field_featured_image }}</div>
  {% endif %}

  <div class="dac-post-card__body">
    <time class="dac-post-card__date" datetime="{{ node.getCreatedTime()|date('c') }}">
      {{ node.getCreatedTime()|format_date('custom', 'j F Y') }}
    </time>

    {{ title_prefix }}
    <h2{{ title_attributes.addClass('dac-post-card__title') }}>
      <a href="{{ url }}" class="dac-post-card__link" rel="bookmark">{{ label }}</a>
    </h2>
    {{ title_suffix }}

    {% if excerpt is not empty %}
      <p class="dac-post-card__excerpt">{{ excerpt }}</p>
    {% endif %}

    <span class="dac-post-card__more" aria-hidden="true">
      {{ 'Read the post'|t }}
      {% include 'drupal_india_connect:icon' ignore missing with { icon: 'arrow-right', icon_size: 'extra-small' } only %}
    </span>
  </div>
</article>
