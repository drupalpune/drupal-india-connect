{% extends "block.html.twig" %}
{#
/**
 * @file
 * Footer branding: event name + venue/date, no logo.
 */
#}
{% set attributes = attributes.addClass('site-branding', 'footer-branding') %}
{% block content %}
  <div class="footer-branding__inner">
    {% if site_name %}
      <div class="footer-branding__name">
        <a href="{{ home_path }}" title="{{ 'Home'|t }}" rel="home">{{ site_name }}</a>
      </div>
    {% endif %}
    {% if footer_venue %}
      <div class="footer-branding__venue">{{ footer_venue }}</div>
    {% endif %}
  </div>
{% endblock %}
