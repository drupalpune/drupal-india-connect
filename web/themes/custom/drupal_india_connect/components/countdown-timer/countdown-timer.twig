{% set units = ['days', 'hours', 'minutes', 'seconds'] %}
{% set unit_labels = {
  days: 'Days'|t,
  hours: 'Hours'|t,
  minutes: 'Minutes'|t,
  seconds: 'Seconds'|t,
} %}

<div class="countdown-timer" data-countdown-target="{{ target_datetime }}">
  {% if label is not empty %}
    <p class="countdown-timer__label">{{ label }}</p>
  {% endif %}

  <div class="countdown-timer__units" aria-hidden="true">
    {% for unit in units %}
      <div class="countdown-timer__unit">
        <span class="countdown-timer__value" data-countdown-unit="{{ unit }}">00</span>
        <span class="countdown-timer__unit-label">{{ unit_labels[unit] }}</span>
      </div>
    {% endfor %}
  </div>

  {#
    The ticking digits above are aria-hidden so screen readers aren't
    spammed with a per-second update. This gives them the target date
    once instead, formatted readably rather than as a raw ISO string.
    `visually-hidden` is Drupal core's utility class.
  #}
  <p class="visually-hidden">
    {{ 'Counting down to @date'|t({ '@date': target_datetime|date('l j F Y, g:ia') }) }}
  </p>

  {% if expired_message is not empty %}
    <p class="countdown-timer__expired-message" hidden>{{ expired_message }}</p>
  {% endif %}
</div>
