{% set has_title = title_top is not empty or title_highlight is not empty or title_bottom is not empty %}
{% set has_meta = date is not empty or location is not empty %}
{% set has_ctas = cta_primary_label is not empty or cta_secondary_label is not empty %}
{% set has_media = video_url is not empty or image.src is not empty %}

<section class="hero-banner">
  <div class="hero-banner__grid">
    <div class="hero-banner__content">
      {% if kicker is not empty %}
        <p class="hero-banner__kicker">
          <span class="hero-banner__kicker-mark" aria-hidden="true"></span>
          {{ kicker }}
        </p>
      {% endif %}

      {% if has_title %}
        <h1 class="hero-banner__title">
          {% if title_top is not empty %}
            <span class="hero-banner__title-line">{{ title_top }}</span>
          {% endif %}
          {% if title_highlight is not empty %}
            <span class="hero-banner__title-line hero-banner__title-line--highlight">{{ title_highlight }}</span>
          {% endif %}
          {% if title_bottom is not empty %}
            <span class="hero-banner__title-line">{{ title_bottom }}</span>
          {% endif %}
        </h1>
      {% endif %}

      {% if description is not empty %}
        <div class="hero-banner__description">{{ description }}</div>
      {% endif %}

      {% if has_meta %}
        <div class="hero-banner__meta">
          {% if date is not empty %}
            <div class="hero-banner__meta-item">
              <span class="hero-banner__meta-label">{{ 'Dates'|t }}</span>
              <span class="hero-banner__meta-value">{{ date }}</span>
            </div>
          {% endif %}
          {% if location is not empty %}
            <div class="hero-banner__meta-item">
              <span class="hero-banner__meta-label">{{ 'Location'|t }}</span>
              <span class="hero-banner__meta-value">{{ location }}</span>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if has_ctas %}
        <div class="hero-banner__actions">
          {% if cta_primary_label is not empty %}
            <a href="{{ cta_primary_url|default('#') }}" class="hero-banner__button hero-banner__button--primary">
              {{ cta_primary_label }}
            </a>
          {% endif %}
          {% if cta_secondary_label is not empty %}
            <a href="{{ cta_secondary_url|default('#') }}" class="hero-banner__button hero-banner__button--secondary">
              {{ cta_secondary_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <div class="hero-banner__visual{{ has_media ? '' : ' hero-banner__visual--empty' }}">
      <span class="hero-banner__visual-accent" aria-hidden="true"></span>

      {% if video_url is not empty %}
        <div class="hero-banner__visual-media">
          <iframe
            src="{{ video_url }}"
            class="hero-banner__video"
            title="{{ media_caption|default('Event video') }}"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      {% elseif image.src is not empty %}
        <div class="hero-banner__visual-media">
          {% include 'canvas:image' ignore missing with {
            src: image.src,
            alt: image.alt,
            class: 'hero-banner__image',
            width: image.width,
            height: image.height,
          } only %}
        </div>
      {% endif %}

      {% if media_caption is not empty %}
        <span class="hero-banner__visual-caption">
          {% if video_url is not empty %}
            {% include 'drupal_india_connect:icon' ignore missing with { icon: 'play-circle', icon_size: 'extra-small' } only %}
          {% endif %}
          {{ media_caption }}
        </span>
      {% endif %}
    </div>
  </div>
</section>
