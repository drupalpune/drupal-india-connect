{#
  The headings travel to each row as CSS custom properties, so the stacked
  mobile layout can label every cell without the row needing to know them.
#}
{% set headings = [column_1, column_2, column_3, column_4]|filter(h => h is not empty) %}
{% set templates = {
  1: '1fr',
  2: 'minmax(10rem, 1fr) 2fr',
  3: 'minmax(10rem, 1.2fr) 1fr 1.6fr',
  4: 'minmax(10rem, 1.2fr) 0.9fr 0.9fr 2fr',
} %}
{% set label_vars = [] %}
{% for heading in headings %}
  {% set label_vars = label_vars|merge(['--data-table-label-' ~ loop.index ~ ': "' ~ heading|replace({'\\': '\\\\', '"': '\\"'}) ~ '"']) %}
{% endfor %}

{# Wrapper only when the optional props are used, so existing tables render unchanged. #}
{% set wrapped = heading is not empty or hide_on_mobile %}
{% if wrapped %}
<div class="data-table-wrap{{ hide_on_mobile ? ' data-table-wrap--hide-on-mobile' }}">
  {% if heading is not empty %}
    <h3 class="data-table__heading">{{ heading }}</h3>
  {% endif %}
{% endif %}
<div class="data-table" role="table"{% if caption is not empty %} aria-label="{{ caption }}"{% endif %}
  style="--data-table-columns: {{ templates[headings|length] }}; {{ label_vars|join('; ') }};">
  <div class="data-table__header" role="rowgroup">
    <div class="data-table__header-row" role="row">
      {% for heading in headings %}
        <span class="data-table__header-cell" role="columnheader">{{ heading }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="data-table__rows" role="rowgroup">
    {% block rows %}{% endblock %}
  </div>
</div>
{% if wrapped %}
</div>
{% endif %}
