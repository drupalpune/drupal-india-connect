{% set has_cta = cta_label is not empty %}
{% set has_secondary = secondary_cta_label is not empty and secondary_cta_url is not empty %}
{% set is_panel = variant == 'panel' %}

<div class="venue-location{{ is_panel ? ' venue-location--panel' }}">
  <div class="venue-location__content">
    <span class="venue-location__label">{{ label|default('Venue') }}</span>

    {% if venue_name is not empty %}
      <h3 class="venue-location__name">{{ venue_name }}</h3>
    {% endif %}

    {% if address is not empty %}
      <p class="venue-location__address">{{ address }}</p>
    {% endif %}

    {% if description is not empty or tbc %}
      <div class="venue-location__description">
        {{ description }}
        {% if tbc %}
          {% include 'drupal_india_connect:tbc-tag' only %}
        {% endif %}
      </div>
    {% endif %}

    {% if has_cta or has_secondary %}
      <div class="venue-location__actions">
        {% if has_cta %}
          <a href="{{ cta_url|default('#') }}" class="venue-location__cta">
            {{ cta_label }}
            {% include 'drupal_india_connect:icon' ignore missing with { icon: 'arrow-right', icon_size: 'extra-small' } only %}
          </a>
        {% endif %}
        {% if has_secondary %}
          <a href="{{ secondary_cta_url }}" class="venue-location__cta venue-location__cta--secondary">
            {{ secondary_cta_label }}
            {% include 'drupal_india_connect:icon' ignore missing with { icon: 'map-pin', icon_size: 'extra-small' } only %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if is_panel %}
    {# The panel stands alone: no map or image. #}
  {% elseif map_embed_url is not empty %}
    <div class="venue-location__media">
      <iframe
        src="{{ map_embed_url }}"
        class="venue-location__map"
        title="{{ 'Map of @venue'|t({ '@venue': venue_name|default('the venue') }) }}"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  {% elseif image.src is not empty %}
    <div class="venue-location__media">
      {% include 'canvas:image' ignore missing with {
        src: image.src,
        alt: image.alt,
        class: 'venue-location__image',
        width: image.width,
        height: image.height,
      } only %}
    </div>
  {% endif %}
</div>
