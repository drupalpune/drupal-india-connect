<div class="milestone-row">
  <div class="milestone-row__cell">
    <span class="milestone-row__label">{{ 'Name'|t }}</span>
    <span class="milestone-row__value milestone-row__value--name">{{ name }}</span>
  </div>

  <div class="milestone-row__cell">
    <span class="milestone-row__label">{{ 'Description'|t }}</span>
    <p class="milestone-row__value">{{ description }}</p>
  </div>

  <div class="milestone-row__cell">
    <span class="milestone-row__label">{{ 'Opens'|t }}</span>
    <span class="milestone-row__value">{{ opens }}</span>
  </div>

  <div class="milestone-row__cell">
    <span class="milestone-row__label">{{ 'Closes'|t }}</span>
    <span class="milestone-row__value">{{ closes }}</span>
  </div>

  <div class="milestone-row__cell">
    <span class="milestone-row__label">{{ 'Key Date / Outcome'|t }}</span>
    <span class="milestone-row__value">{{ outcome }}</span>
  </div>
</div>
