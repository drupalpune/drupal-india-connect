<?php

/**
 * @file
 * Theme-specific PHP hooks for DrupalAsia Connect.
 */

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 *
 * Drupal Canvas's page-region editor doesn't support this theme's regions
 * yet (fatal error on the region entity, see project notes), so the
 * save-the-date announcement bar is rendered directly here instead of
 * through Canvas. event_horizon's page.html.twig prints {{ page.header }}
 * immediately above the site-header include, which is exactly the
 * "above the header, site-wide" placement the design calls for — so this
 * appends the same SDC into that existing region's render array.
 */
function drupal_india_connect_preprocess_page(array &$variables) {
  $variables['page']['header']['drupalasia_announcement_bar'] = [
    '#type' => 'component',
    '#component' => 'drupal_india_connect:announcement-bar',
    '#props' => [
      'message' => 'Save the date — 21–23 January 2027',
      'detail' => 'IIT Bombay',
      'variant' => 'secondary',
    ],
    '#weight' => -100,
  ];

  // The design's footer carries the Drupal trademark attribution. The
  // event_platform_helper copyright block renders a fixed "All rights
  // reserved" line with no setting for this, so append it separately
  // rather than forking that block's template.
  $variables['page']['footer']['drupalasia_trademark'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#attributes' => ['class' => ['dac-footer__trademark']],
    '#value' => t('Drupal is a registered trademark of Dries Buytaert.'),
    '#weight' => 20,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for event-platform-copyright-block.html.twig.
 *
 * The block prints date('Y') alone, so the footer read "DrupalAsia Connect
 * 2026" next to a hero announcing 2027 — which scans as a different event
 * rather than a copyright date. Print the span instead: from the year the
 * site is being published to the year of the event, read from the same term
 * the hero uses so the two cannot drift apart.
 *
 * The two collapse to a single year when they are the same, and are ordered
 * lowest first so the range still reads correctly after the event.
 */
function drupal_india_connect_preprocess_event_platform_copyright_block(array &$variables) {
  $event_details = \Drupal\config_pages\Entity\ConfigPages::config('event_details');
  if (!$event_details) {
    return;
  }

  $current = $event_details->get('field_current')?->getValue();
  while (is_array($current)) {
    $current = array_pop($current);
  }
  if (!$current) {
    return;
  }

  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($current);
  $start = $term?->get('field_dates')?->value;
  if (!$start) {
    return;
  }

  $event_year = (int) date('Y', is_numeric($start) ? (int) $start : strtotime($start));
  $this_year = (int) date('Y');
  $from = min($this_year, $event_year);
  $to = max($this_year, $event_year);

  $variables['year'] = $from === $to ? (string) $from : $from . '–' . $to;
}


/**
 * Implements hook_preprocess_block().
 */
function drupal_india_connect_preprocess_block(&$variables) {
  // The footer's menu blocks reuse the main and footer menus, but must not
  // render with menu--main.html.twig: that template (and the
  // navigation-primary library it attaches) builds the header's interactive
  // dropdown nav. Force the plain, footer-appropriate menu--footer.html.twig
  // (and its footer-menu library) instead, keeping the same links.
  $footer_menu_blocks = [
    'drupal_india_connect_footer_main_menu',
    'drupal_india_connect_footer_legal_menu',
  ];
  if (in_array($variables['elements']['#id'] ?? NULL, $footer_menu_blocks, TRUE)) {
    $variables['content']['#theme'] = 'menu__footer';
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu--footer.html.twig.
 */
function drupal_india_connect_preprocess_menu__footer(&$variables) {
  // The footer must not show sub-menus: only links that point to an actual
  // page. A parent item with no URL of its own (e.g. "Program", used only
  // to group "Program at a glance") is dropped and its linked children are
  // promoted to the top level instead of being nested underneath it.
  $variables['items'] = _drupal_india_connect_flatten_footer_menu_items($variables['items']);
}

/**
 * Recursively drops <nolink> items, promoting their linked children.
 */
function _drupal_india_connect_flatten_footer_menu_items(array $items) {
  $flattened = [];
  foreach ($items as $item) {
    $is_nolink = $item['url']->isRouted() && $item['url']->getRouteName() === '<nolink>';
    if ($is_nolink) {
      if (!empty($item['below'])) {
        $flattened = array_merge($flattened, _drupal_india_connect_flatten_footer_menu_items($item['below']));
      }
      continue;
    }
    // No sub-menus in the footer: drop any children.
    $item['below'] = [];
    $flattened[] = $item;
  }
  return $flattened;
}

/**
 * Implements hook_preprocess_HOOK() for menu--footer-social.html.twig.
 *
 * The "Social media links" menu (Structure > Menus > Social media links)
 * only carries a title and a URL per link — editors don't pick an icon.
 * Instead the icon is matched from the link's own domain, so adding a
 * LinkedIn URL is enough to get the LinkedIn glyph; a network with no menu
 * link here just never appears in the loop. An unrecognised domain still
 * renders as a plain (icon-less) link rather than being dropped.
 *
 * Mastodon is federated — an instance can be hosted on any domain — so it
 * can't be keyed off a fixed host the way the others are. A handful of the
 * largest public instances are listed directly; anything else falls back to
 * matching "mastodon" in the link's own title, which is how editors already
 * label these links in practice.
 */
function drupal_india_connect_preprocess_menu__footer_social(array &$variables) {
  $icons_by_domain = [
    'linkedin.com' => 'linkedin-logo',
    'x.com' => 'x-logo',
    'twitter.com' => 'x-logo',
    'facebook.com' => 'facebook-logo',
    'fb.com' => 'facebook-logo',
    'instagram.com' => 'instagram-logo',
    'youtube.com' => 'youtube-logo',
    'youtu.be' => 'youtube-logo',
    'mastodon.social' => 'mastodon-logo',
    'mastodon.online' => 'mastodon-logo',
    'mstdn.social' => 'mastodon-logo',
    'fosstodon.org' => 'mastodon-logo',
  ];

  foreach ($variables['items'] as &$item) {
    $host = parse_url($item['url']->toString(), PHP_URL_HOST) ?? '';
    $host = strtolower(preg_replace('/^www\./', '', $host));
    if (isset($icons_by_domain[$host])) {
      $item['icon'] = $icons_by_domain[$host];
    }
    elseif (str_contains(strtolower((string) $item['title']), 'mastodon')) {
      $item['icon'] = 'mastodon-logo';
    }
    else {
      $item['icon'] = NULL;
    }
  }
}
