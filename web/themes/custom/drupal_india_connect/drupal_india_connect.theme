<?php

use Drupal\Core\Render\Markup;

/**
 * @file
 * Theme-specific PHP hooks for DrupalAsia Connect.
 */

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 *
 * Drupal Canvas's page-region editor doesn't support this theme's regions
 * yet (fatal error on the region entity, see project notes), so the
 * save-the-date announcement bar is rendered directly here instead of
 * through Canvas. event_horizon's page.html.twig prints {{ page.header }}
 * immediately above the site-header include, which is exactly the
 * "above the header, site-wide" placement the design calls for — so this
 * appends the same SDC into that existing region's render array.
 */
function drupal_india_connect_preprocess_page(array &$variables) {
  $variables['page']['header']['drupalasia_announcement_bar'] = [
    '#type' => 'component',
    '#component' => 'drupal_india_connect:announcement-bar',
    '#props' => [
      'message' => 'Save the date — 28–30 January 2027',
      'detail' => 'IIT Bombay',
      'variant' => 'secondary',
    ],
    '#weight' => -100,
  ];

  // The design's footer carries the Drupal trademark attribution. The
  // event_platform_helper copyright block renders a fixed "All rights
  // reserved" line with no setting for this, so append it separately
  // rather than forking that block's template.
  $variables['page']['footer']['drupalasia_trademark'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#attributes' => ['class' => ['dac-footer__trademark']],
    '#value' => t('Drupal is a registered trademark of Dries Buytaert.'),
    '#weight' => 20,
  ];

  $nudge = _drupal_india_connect_profile_nudge();
  if ($nudge) {
    $variables['page']['content']['drupalasia_profile_nudge'] = $nudge;
  }
}

/**
 * Builds the "fill in your profile" nudge shown on a user's own account page.
 *
 * field_drupal_org_username and field_drupal_slack_username (added for
 * speaker profiles) are both optional, so existing accounts created before
 * those fields have neither filled in. Rather than emailing every
 * existing user, the cheapest nudge is an on-page message shown only when
 * the viewer is looking at their own account and at least one of the two
 * fields is still blank. Dismissal is handled client-side (see
 * js/profile-nudge.js) — there is no server-persisted "dismissed" flag, so
 * this always renders the same markup and lets the JS decide whether to
 * hide it, keyed by uid in localStorage.
 */
function _drupal_india_connect_profile_nudge(): ?array {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() !== 'entity.user.canonical') {
    return NULL;
  }

  /** @var \Drupal\user\UserInterface|null $viewed_user */
  $viewed_user = $route_match->getParameter('user');
  if (!$viewed_user) {
    return NULL;
  }

  $current_user = \Drupal::currentUser();
  if ((int) $viewed_user->id() !== (int) $current_user->id()) {
    return NULL;
  }

  $has_org = (bool) trim((string) $viewed_user->get('field_drupal_org_username')->value);
  $has_slack = (bool) trim((string) $viewed_user->get('field_drupal_slack_username')->value);
  if ($has_org && $has_slack) {
    return NULL;
  }

  // event_horizon's templates/layout/container.html.twig overrides the
  // core 'container' theme hook to print only {{ children }} (it exists so
  // that theme's own layout containers render without an extra wrapper
  // div). That override is theme-wide, so a plain '#type' => 'container'
  // here would silently lose its id/class/data-uid — which is exactly what
  // breaks both the dismiss button (its JS selector never matches) and the
  // styling (the CSS class never reaches the DOM). 'html_tag' has no
  // #theme hook to intercept, so it renders normally.
  return [
    '#type' => 'html_tag',
    '#tag' => 'div',
    '#attributes' => [
      'id' => 'dac-profile-nudge',
      'class' => ['dac-profile-nudge'],
      'data-uid' => $viewed_user->id(),
    ],
    'message' => [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#attributes' => ['class' => ['dac-profile-nudge__message']],
      '#value' => t('Add your Drupal.org and Drupal Slack usernames so other attendees and organisers can find you. <a href=":url">Update your profile</a>.', [
        ':url' => $viewed_user->toUrl('edit-form')->toString(),
      ]),
    ],
    'dismiss' => [
      '#type' => 'html_tag',
      '#tag' => 'button',
      '#attributes' => [
        'type' => 'button',
        'class' => ['dac-profile-nudge__dismiss'],
        'aria-label' => t('Dismiss'),
      ],
      // The theme's closed icon set's "x" glyph (see event_horizon's
      // components/icon/icon.twig), inlined directly since #value only
      // accepts plain text or MarkupInterface — not a themeable icon
      // render array — inside an html_tag button.
      '#value' => Markup::create('<svg class="dac-profile-nudge__dismiss-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"/></svg>'),
    ],
    '#attached' => [
      'library' => ['drupal_india_connect/profile-nudge'],
    ],
    '#weight' => -50,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for event-platform-copyright-block.html.twig.
 *
 * The block prints date('Y') alone, so the footer read "DrupalAsia Connect
 * 2026" next to a hero announcing 2027 — which scans as a different event
 * rather than a copyright date. Print the span instead: from the year the
 * site is being published to the year of the event, read from the same term
 * the hero uses so the two cannot drift apart.
 *
 * The two collapse to a single year when they are the same, and are ordered
 * lowest first so the range still reads correctly after the event.
 */
function drupal_india_connect_preprocess_event_platform_copyright_block(array &$variables) {
  $term = _drupal_india_connect_current_event_term();
  $start = $term?->get('field_dates')?->value;
  if (!$start) {
    return;
  }

  $event_year = (int) date('Y', is_numeric($start) ? (int) $start : strtotime($start));
  $this_year = (int) date('Y');
  $from = min($this_year, $event_year);
  $to = max($this_year, $event_year);

  $variables['year'] = $from === $to ? (string) $from : $from . '–' . $to;
}

/**
 * Implements hook_preprocess_HOOK() for block--drupal-india-connect-footer-branding.html.twig.
 *
 * This block previously hardcoded "IIT Bombay · Jan 21–23, 2027" as a
 * literal string in the template, while the hero pulls the same venue and
 * dates from the current event term (see
 * EventPlatformTwigExtension::getHeroContext()). A hardcoded copy drifts
 * silently the moment the event is rescheduled or rolled over to a new
 * edition. Read from the same term instead, formatted the same way the
 * hero formats it, so the two cannot disagree.
 */
function drupal_india_connect_preprocess_block__drupal_india_connect_footer_branding(array &$variables) {
  $term = _drupal_india_connect_current_event_term();
  $start = $term?->get('field_dates')?->value;
  if (!$term || !$start) {
    return;
  }

  $location = $term->get('field_location_short')->value;
  $end = $term->get('field_dates')->end_value ?? $start;
  $formatted_dates = \Drupal::service('smart_date.manager')->formatSmartDate(
    strtotime($start),
    strtotime($end),
    'compact_date_only',
    NULL,
    'string'
  );

  if ($location && $formatted_dates) {
    $variables['footer_venue'] = $location . ' · ' . $formatted_dates;
  }
}

/**
 * Loads the taxonomy term for the event configured as "current" in the
 * event_details Config Pages entity, or NULL if none is set up yet.
 *
 * Shared by the preprocess hooks above so the footer's venue/date line and
 * the copyright year read from the exact same source and cannot drift
 * apart from each other.
 */
function _drupal_india_connect_current_event_term(): ?\Drupal\taxonomy\TermInterface {
  $event_details = \Drupal\config_pages\Entity\ConfigPages::config('event_details');
  if (!$event_details) {
    return NULL;
  }

  $current = $event_details->get('field_current')?->getValue();
  while (is_array($current)) {
    $current = array_pop($current);
  }
  if (!$current) {
    return NULL;
  }

  return \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($current);
}


/**
 * Implements hook_preprocess_block().
 */
function drupal_india_connect_preprocess_block(&$variables) {
  // The footer's menu blocks reuse the main and footer menus, but must not
  // render with menu--main.html.twig: that template (and the
  // navigation-primary library it attaches) builds the header's interactive
  // dropdown nav. Force the plain, footer-appropriate menu--footer.html.twig
  // (and its footer-menu library) instead, keeping the same links.
  $footer_menu_blocks = [
    'drupal_india_connect_footer_main_menu',
    'drupal_india_connect_footer_legal_menu',
  ];
  if (in_array($variables['elements']['#id'] ?? NULL, $footer_menu_blocks, TRUE)) {
    $variables['content']['#theme'] = 'menu__footer';
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu--footer.html.twig.
 */
function drupal_india_connect_preprocess_menu__footer(&$variables) {
  // The main menu keeps its tree here: the footer's link columns are built
  // from it, one column per top-level item (see menu--footer.html.twig).
  if (($variables['menu_name'] ?? NULL) === 'main') {
    return;
  }

  // Every other footer menu is the utility row, a single line of links —
  // no sub-menus, and no parent item that has no URL of its own.
  $variables['items'] = _drupal_india_connect_flatten_footer_menu_items($variables['items']);
}

/**
 * Recursively drops <nolink> items, promoting their linked children.
 */
function _drupal_india_connect_flatten_footer_menu_items(array $items) {
  $flattened = [];
  foreach ($items as $item) {
    $is_nolink = $item['url']->isRouted() && $item['url']->getRouteName() === '<nolink>';
    if ($is_nolink) {
      if (!empty($item['below'])) {
        $flattened = array_merge($flattened, _drupal_india_connect_flatten_footer_menu_items($item['below']));
      }
      continue;
    }
    // No sub-menus in the footer: drop any children.
    $item['below'] = [];
    $flattened[] = $item;
  }
  return $flattened;
}

/**
 * Implements hook_preprocess_HOOK() for menu--footer-social.html.twig.
 *
 * The "Social media links" menu (Structure > Menus > Social media links)
 * only carries a title and a URL per link — editors don't pick an icon.
 * Instead the icon is matched from the link's own domain, so adding a
 * LinkedIn URL is enough to get the LinkedIn glyph; a network with no menu
 * link here just never appears in the loop. An unrecognised domain still
 * renders as a plain (icon-less) link rather than being dropped.
 *
 * Mastodon is federated — an instance can be hosted on any domain — so it
 * can't be keyed off a fixed host the way the others are. A handful of the
 * largest public instances are listed directly; anything else falls back to
 * matching "mastodon" in the link's own title, which is how editors already
 * label these links in practice.
 */
function drupal_india_connect_preprocess_menu__footer_social(array &$variables) {
  $icons_by_domain = [
    'linkedin.com' => 'linkedin-logo',
    'x.com' => 'x-logo',
    'twitter.com' => 'x-logo',
    'facebook.com' => 'facebook-logo',
    'fb.com' => 'facebook-logo',
    'instagram.com' => 'instagram-logo',
    'youtube.com' => 'youtube-logo',
    'youtu.be' => 'youtube-logo',
    'mastodon.social' => 'mastodon-logo',
    'mastodon.online' => 'mastodon-logo',
    'mstdn.social' => 'mastodon-logo',
    'fosstodon.org' => 'mastodon-logo',
  ];

  foreach ($variables['items'] as &$item) {
    $host = parse_url($item['url']->toString(), PHP_URL_HOST) ?? '';
    $host = strtolower(preg_replace('/^www\./', '', $host));
    if (isset($icons_by_domain[$host])) {
      $item['icon'] = $icons_by_domain[$host];
    }
    elseif (str_contains(strtolower((string) $item['title']), 'mastodon')) {
      $item['icon'] = 'mastodon-logo';
    }
    else {
      $item['icon'] = NULL;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 *
 * The blog listing's header and empty text are styled by the blog library,
 * which the article card template also attaches; attach it here too so an
 * empty /blogs is styled.
 */
function drupal_india_connect_preprocess_views_view(array &$variables) {
  if ($variables['view']->id() === 'blog') {
    $variables['#attached']['library'][] = 'drupal_india_connect/blog';
  }
  if ($variables['view']->id() === 'session_ratings') {
    $variables['#attached']['library'][] = 'drupal_india_connect/session-ratings';
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Puts the moderator's "Your evaluation" card in the session page's
 * sidebar column, above the "Session details" card. Who sees it is
 * unchanged from when this was the session_evaluation view: that view's
 * access still decides (session moderators and administrators), and it
 * only shows while the session is still Proposed.
 *
 * The card itself is built here rather than by the view because the view's
 * webform field prints the Likert answers as one <ul> of "<b>Label:</b> 9"
 * strings, which leaves nothing to hang a score bar on, and its edit link
 * went to the admin-themed submission page instead of a modal.
 */
function drupal_india_connect_preprocess_node(array &$variables) {
  $node = $variables['node'];
  if ($node->bundle() !== 'session' || $variables['view_mode'] !== 'full') {
    return;
  }

  $variables['#cache']['contexts'][] = 'user.roles';
  if (!$node->hasField('moderation_state') || $node->get('moderation_state')->value !== 'proposed') {
    return;
  }

  $view = \Drupal\views\Views::getView('session_evaluation');
  if (!$view || !$view->access('block_1')) {
    return;
  }

  $variables['session_evaluation'] = _drupal_india_connect_session_evaluation_card($node);
}

/**
 * Builds the current user's evaluation card for a proposed session.
 *
 * Shows their ratings and comments with an "Edit evaluation" button, or an
 * "Evaluate this session" button if they have not rated it yet. Both open
 * the webform in a modal; the form's confirmation redirects back to the
 * session, so the page reloads with the updated card.
 */
function _drupal_india_connect_session_evaluation_card(\Drupal\node\NodeInterface $node): array {
  $webform = \Drupal\webform\Entity\Webform::load('session_evaluation');
  $uid = \Drupal::currentUser()->id();
  $build = [
    '#theme' => 'session_evaluation_card',
    '#cache' => [
      'contexts' => ['user'],
      'tags' => ['webform_submission_list', 'config:webform.webform.session_evaluation'],
    ],
    '#attached' => ['library' => ['core/drupal.dialog.ajax']],
  ];

  // The session is stored as the webform's "session" element value, not as
  // the submission's source entity, so look it up in the submission data.
  $query = \Drupal::database()->select('webform_submission', 's');
  $query->join('webform_submission_data', 'd', 'd.sid = s.sid');
  $sid = $query->fields('s', ['sid'])
    ->condition('s.webform_id', 'session_evaluation')
    ->condition('s.uid', $uid)
    ->condition('d.name', 'session')
    ->condition('d.value', $node->id())
    ->orderBy('s.sid', 'DESC')
    ->range(0, 1)
    ->execute()
    ->fetchField();
  $submission = $sid ? \Drupal\webform\Entity\WebformSubmission::load($sid) : NULL;

  if (!$submission) {
    $build['#action_url'] = \Drupal\Core\Url::fromRoute('entity.webform.canonical', ['webform' => 'session_evaluation'], [
      'query' => ['session' => $node->id()],
    ]);
    $build['#action_label'] = t('Evaluate this session');
    return $build;
  }

  // Criteria in the order the form asks them (the stored answers are keyed
  // alphabetically), scored against the top of the Likert answer scale.
  $element = $webform->getElement('ratings');
  $answers_element = ['#options' => $element['#answers']];
  $answers = \Drupal\webform\Entity\WebformOptions::getElementOptions($answers_element);
  $max = max(array_map('intval', array_keys($answers)));
  $data = $submission->getData();
  $criteria = [];
  foreach ($element['#questions'] as $question => $question_label) {
    if (!isset($data['ratings'][$question]) || $data['ratings'][$question] === '') {
      continue;
    }
    $score = (int) $data['ratings'][$question];
    $criteria[] = [
      'label' => $question_label,
      'score' => $score,
      'percent' => round($score / $max * 100),
    ];
  }

  $build['#criteria'] = $criteria;
  $build['#max'] = $max;
  $build['#average'] = $criteria ? number_format(array_sum(array_column($criteria, 'score')) / count($criteria), 1) : NULL;
  $build['#comments'] = trim((string) ($data['comments'] ?? ''));
  // The front-end edit route, not $submission->toUrl('edit-form'), which is
  // the admin-themed /admin/structure/webform/… page.
  $build['#action_url'] = \Drupal\Core\Url::fromRoute('entity.webform.user.submission.edit', [
    'webform' => 'session_evaluation',
    'webform_submission' => $submission->id(),
  ]);
  $build['#action_label'] = t('Edit evaluation');
  $build['#cache']['tags'] = array_merge($build['#cache']['tags'], $submission->getCacheTags());
  return $build;
}

/**
 * Implements hook_theme().
 */
function drupal_india_connect_theme($existing, $type, $theme, $path) {
  return [
    'session_evaluation_card' => [
      'variables' => [
        'criteria' => [],
        'max' => 10,
        'average' => NULL,
        'comments' => '',
        'action_url' => NULL,
        'action_label' => '',
      ],
      'path' => $path . '/templates/content',
    ],
  ];
}
